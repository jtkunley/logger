{
    "name": "@jtkunley/logger",
    "version": "1.0.0",
    "private": true,
    "description": "Structured JSON logging for Node services, built on winston, with per-request context injection and bounded serialization",
    "keywords": [
        "logger",
        "logging",
        "structured-logging",
        "json",
        "winston",
        "correlation-id",
        "asynclocalstorage",
        "typescript"
    ],
    "author": "jtkunley <jtkunley@gmail.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jtkunley/logger.git"
    },
    "homepage": "https://github.com/jtkunley/logger#readme",
    "bugs": {
        "url": "https://github.com/jtkunley/logger/issues"
    },
    "type": "commonjs",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "npm run clean && tsc -p tsconfig.build.json",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "prepare": "npm run build",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "winston": "^3.18.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.0.0",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.0.5",
        "winston-transport": "^4.9.0"
    }
}
